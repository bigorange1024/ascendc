{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: Build (Makefile → build/app)",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C: Run main (build/app)",
      "type": "shell",
      "command": "./build/app; echo ''; echo '[done] exit code='$?",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["C: Build (Makefile → build/app)"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "C: Clean",
      "type": "shell",
      "command": "make clean",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "C: Build (CMake → build/cmake/app)",
      "type": "shell",
      "command": "cmake -S . -B build/cmake -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake -j",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C: Run main (CMake app)",
      "type": "shell",
      "command": "./build/cmake/app; echo ''; echo '[done] exit code='$?",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["C: Build (CMake → build/cmake/app)"],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
